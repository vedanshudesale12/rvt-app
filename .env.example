# Copy to .env.local for `npm run dev`. Never commit real values.
# Production secrets go in the Cloudflare dashboard or `wrangler secret put`.

# --- Supabase (browser may see only the two NEXT_PUBLIC_ values) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL for backups (server / CI only).
BACKUP_DATABASE_URL=

# 32 random bytes, base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Long random string. Signs the idle-timeout cookie.
SESSION_SECRET=

# Bearer token for /api/cron/keepalive and the weekly sheet export.
CRON_SECRET=

# Public site origin, no trailing slash. Used in emails and push links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Gemini (server only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Resend (server only). RESEND_FROM is the verified sender, address TBD. ---
RESEND_API_KEY=
RESEND_FROM=

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local only. Refused when NODE_ENV=production.
# TURNSTILE_BYPASS=1

# Set COOKIE_SECURE=1 behind HTTPS. Leave unset for http://localhost.
# COOKIE_SECURE=1

# Local click-through without Supabase. Refused when NODE_ENV=production.
# RVT_DEMO=1

# Grievance contact printed on the legal pages.
LEGAL_CONTACT_EMAIL=ops@example.com

# Optional Sentry DSN. Leave empty to disable.
SENTRY_DSN=

# Web push. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Weekly Google Sheets export (scripts/weekly-sheets.mjs). JSON on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Password used by scripts/create-seed-users.mjs. Do not reuse a personal password.
SEED_PASSWORD=
