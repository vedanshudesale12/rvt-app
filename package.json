{
  "name": "backstage-rvt",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "seed-users": "node scripts/create-seed-users.mjs",
    "backup": "bash scripts/backup.sh",
    "sheets": "node scripts/weekly-sheets.mjs"
  },
  "dependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.18",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
